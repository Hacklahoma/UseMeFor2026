# Hacklahoma Admin GUI Configuration

# Enable/Disable Admin GUI (CRITICAL: Set to false in production)
ADMIN_GUI_ENABLED=true

# Server Configuration
ADMIN_GUI_PORT=5002
NODE_ENV=development

# Security Configuration
ADMIN_GUI_SECRET=your-super-secret-admin-key-change-this
SESSION_SECRET=your-session-secret-key-change-this

# Main API Server Configuration
MAIN_API_URL=http://localhost:5001
MAIN_API_ADMIN_PATH=/admin

# IP Whitelist (comma-separated, leave empty to allow all in dev)
ALLOWED_IPS=

# Session Configuration
SESSION_TTL=3600

# Security Headers
ENABLE_SECURITY_HEADERS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
